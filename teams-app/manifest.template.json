{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.30/MicrosoftTeams.schema.json",
  "manifestVersion": "1.30",
  "version": "1.0.0",
  "id": "{{TEAMS_APP_ID}}",
  "developer": {
    "name": "DecisionForge",
    "websiteUrl": "{{LANDOPS_WEB_URL}}",
    "privacyUrl": "{{LANDOPS_WEB_URL}}/privacy",
    "termsOfUseUrl": "{{LANDOPS_WEB_URL}}/terms"
  },
  "name": {
    "short": "LandOps",
    "full": "LandOps Workroom"
  },
  "description": {
    "short": "Evidence-backed land operations collaboration.",
    "full": "LandOps routes evidence-backed land operations questions through a bounded Workroom and keeps consequential actions with a human reviewer."
  },
  "icons": {
    "outline": "outline.png",
    "color": "color.png"
  },
  "accentColor": "#1F6FEB",
  "bots": [
    {
      "botId": "{{TEAMS_BOT_APP_ID}}",
      "scopes": [
        "personal",
        "team",
        "groupchat"
      ],
      "supportsFiles": false,
      "isNotificationOnly": false,
      "commandLists": [
        {
          "scopes": [
            "team",
            "groupchat"
          ],
          "commands": [
            {
              "title": "Review ownership gaps",
              "description": "Ask LandOps to review the bounded ownership-gap scenario."
            }
          ]
        }
      ]
    }
  ],
  "permissions": [
    "identity"
  ]
}
