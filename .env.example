BUSINESS_AGENT_WORKSPACE=/tmp/business-agent-run
BUSINESS_AGENT_DOMAINS_ROOT=domains
FOUNDRY_ENDPOINT=
FOUNDRY_API_KEY=
FOUNDRY_MODEL=
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=
AZURE_SEARCH_API_KEY=

# Local identity mode. Production sets these through App Service configuration
# and Microsoft Entra ID; it does not use shared application passwords.
BUSINESS_AGENT_IDENTITY_MODE=local
BUSINESS_AGENT_WORKROOM_PERSISTENCE=memory
BUSINESS_AGENT_WORKROOM_EXECUTION_PROVIDER=deterministic
BUSINESS_AGENT_CONVERSATION_PROVIDER=deterministic

# Optional local Microsoft Teams adapter. The adapter calls the same .NET
# Workroom API as the web app and uses deterministic defaults for the demo.
BUSINESS_AGENT_API_URL=http://127.0.0.1:5006
LANDOPS_API_URL=http://127.0.0.1:5006 # compatibility alias
LANDOPS_WEB_URL=http://127.0.0.1:3000
TEAMS_PORT=3978
BUSINESS_AGENT_TEAMS_CASE_ID=case-braxton-4700701733
BUSINESS_AGENT_TEAMS_SCENARIO_ID=land-ownership-gaps
BUSINESS_AGENT_TEAMS_ROLE_ID=land-analyst
BUSINESS_AGENT_TEAMS_GROUP=title-curative-board

# Azure Developer CLI deployment metadata. Keep real values in the local
# ignored .env or AZD environment; never commit tokens, passwords, or keys.
AZURE_ENV_NAME=landops-dev
AZURE_LOCATION=westus2
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
SQL_ADMIN_OBJECT_ID=
SQL_ADMIN_LOGIN=LandOps SQL Administrator
API_MANAGED_IDENTITY_PRINCIPAL_ID=
API_MANAGED_IDENTITY_CLIENT_ID=
ENTRA_TENANT_ID=
ENTRA_AUDIENCE=
FOUNDRY_SCOPE=https://cognitiveservices.azure.com/.default
FOUNDRY_USE_MANAGED_IDENTITY=true
BUSINESS_AGENT_APPLY_MIGRATIONS=false

# One-time deployment migration controls. These are documentation placeholders
# only. The migration must run as an approved Entra SQL administrator; do not
# place a SQL password here.
BUSINESS_AGENT_MIGRATION_MODE=separate-privileged-step
BUSINESS_AGENT_MIGRATION_COMMAND=dotnet ef database update
