FOUNDRY_ENDPOINT=
FOUNDRY_API_KEY=
FOUNDRY_MODEL=
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=
AZURE_SEARCH_API_KEY=

# Azure Developer CLI deployment metadata. Copy this template to
# .azure/companyagent-dev/.env after `azd env new`, or set the values with
# `azd env set`. The deployment scripts read that ignored file. Shell variables
# override file values. Never commit tokens, passwords, or keys.
AZURE_ENV_NAME=companyagent-dev
AZURE_LOCATION=westus2
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=rg-companyagent-dev
COPILOT_ENVIRONMENT_ID=
COMPANY_AGENT_ID=
COMPANY_AGENT_SCHEMA_NAME=
LAND_AGENT_ID=
LAND_AGENT_SCHEMA_NAME=
HR_AGENT_ID=
HR_AGENT_SCHEMA_NAME=
COPILOT_SOLUTION_NAME=
COMPANY_AGENT_API_URL=
COMPANY_AGENT_APP_INSIGHTS_NAME=
COPILOT_DIRECT_LINE_TOKEN_ENDPOINT=
# Alternative for secured Direct Line access. Keep this secret only in the
# ignored AZD environment file; do not commit it.
COPILOT_DIRECT_LINE_SECRET=
COPILOT_AGENTS_SDK_CONNECTION_STRING=
COPILOT_E2E_CLIENT_ID=
COPILOT_TENANT_ID=
COPILOT_E2E_REDIRECT_URI=http://localhost
COPILOT_E2E_TIMEOUT_SECONDS=90
SQL_ADMIN_OBJECT_ID=
SQL_ADMIN_LOGIN=LandOps SQL Administrator
API_MANAGED_IDENTITY_PRINCIPAL_ID=
API_MANAGED_IDENTITY_CLIENT_ID=
ENTRA_TENANT_ID=
ENTRA_AUDIENCE=
FOUNDRY_SCOPE=https://cognitiveservices.azure.com/.default
FOUNDRY_USE_MANAGED_IDENTITY=true

# One-time deployment migration controls. These are documentation placeholders
# only. The migration must run as an approved Entra SQL administrator; do not
# place a SQL password here.
COMPANY_AGENT_MIGRATION_MODE=separate-privileged-step
COMPANY_AGENT_MIGRATION_COMMAND=dotnet ef database update
